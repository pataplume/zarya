# ─── Zarya Landing — Variables d'environnement ───────────────────────────────
# Copier ce fichier en .env.local et renseigner les valeurs.
# Ne jamais commiter .env.local

# Supabase (optionnel — pour stocker les demandes pilote)
# Créer une table pilot_signups (email, cabinet, collaborateurs, logiciel, created_at)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Resend (optionnel — pour recevoir une notification email à chaque demande)
RESEND_API_KEY=
NOTIFY_EMAIL=contact@condere.ch

# URL de base (utilisée par Next.js pour les métadonnées)
NEXT_PUBLIC_SITE_URL=https://zarya.condere.ch
